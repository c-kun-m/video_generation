{
  "$defs": {
    "ApprovalRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "approval",
          "default": "approval",
          "title": "Kind",
          "type": "string"
        },
        "approval_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Approval Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id"
      ],
      "title": "ApprovalRef",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "content",
          "default": "content",
          "title": "Kind",
          "type": "string"
        },
        "entity_kind": {
          "enum": [
            "brief",
            "script",
            "storyboard"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "revision_id",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ProjectEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Event Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "enum": [
            "project.created",
            "project.updated",
            "content.saved",
            "content.reviewed",
            "run.created",
            "run.control_requested",
            "run.updated",
            "run.step_completed"
          ],
          "title": "Type",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "subject_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectRef"
            },
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "$ref": "#/$defs/ApprovalRef"
            },
            {
              "$ref": "#/$defs/RunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Ref"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "row_version": {
          "title": "Row Version",
          "type": "integer"
        },
        "causation_command_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Causation Command Id",
          "type": "string"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "seq",
        "type",
        "project_id",
        "row_version",
        "causation_command_id",
        "occurred_at"
      ],
      "title": "ProjectEvent",
      "type": "object"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "project",
          "default": "project",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectRef",
      "type": "object"
    },
    "RunRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "production_run",
          "default": "production_run",
          "title": "Kind",
          "type": "string"
        },
        "production_run_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Production Run Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "production_run_id",
        "snapshot_id"
      ],
      "title": "RunRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ProjectEvent"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "title": "Next Cursor",
      "type": "integer"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "has_more"
  ],
  "title": "EventPage",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
