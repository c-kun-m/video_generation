{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Approval Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "subject_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "policy_version": {
          "const": "manual-content/v1",
          "default": "manual-content/v1",
          "title": "Policy Version",
          "type": "string"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Actor Id",
          "type": "string"
        },
        "command_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Command Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "project_id",
        "subject_ref",
        "decision",
        "comment",
        "actor_id",
        "command_id",
        "created_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "BriefContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "brief",
          "default": "brief",
          "title": "Kind",
          "type": "string"
        },
        "theme": {
          "default": "",
          "maxLength": 20000,
          "title": "Theme",
          "type": "string"
        },
        "audience": {
          "default": "",
          "maxLength": 20000,
          "title": "Audience",
          "type": "string"
        },
        "purpose": {
          "default": "",
          "maxLength": 20000,
          "title": "Purpose",
          "type": "string"
        },
        "style": {
          "default": "",
          "maxLength": 20000,
          "title": "Style",
          "type": "string"
        },
        "constraints": {
          "default": "",
          "maxLength": 20000,
          "title": "Constraints",
          "type": "string"
        }
      },
      "title": "BriefContent",
      "type": "object"
    },
    "ContentHead": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "enum": [
            "brief",
            "script",
            "storyboard"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "row_version": {
          "title": "Row Version",
          "type": "integer"
        },
        "current": {
          "$ref": "#/$defs/ContentRevision"
        },
        "review_status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "upstream_outdated": {
          "default": false,
          "title": "Upstream Outdated",
          "type": "boolean"
        }
      },
      "required": [
        "entity_kind",
        "row_version",
        "current",
        "review_status"
      ],
      "title": "ContentHead",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "content",
          "default": "content",
          "title": "Kind",
          "type": "string"
        },
        "entity_kind": {
          "enum": [
            "brief",
            "script",
            "storyboard"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "revision_id",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ContentRevision": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "parent_revision_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Revision Id"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "brief": "#/$defs/BriefContent",
              "script": "#/$defs/ScriptContent",
              "storyboard": "#/$defs/StoryboardContent"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BriefContent"
            },
            {
              "$ref": "#/$defs/ScriptContent"
            },
            {
              "$ref": "#/$defs/StoryboardContent"
            }
          ],
          "title": "Payload"
        },
        "created_by": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "project_id",
        "revision",
        "parent_revision_id",
        "payload",
        "created_by",
        "created_at"
      ],
      "title": "ContentRevision",
      "type": "object"
    },
    "ProductionRun": {
      "additionalProperties": false,
      "properties": {
        "production_run_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Production Run Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "execution_mode": {
          "const": "simulation",
          "default": "simulation",
          "title": "Execution Mode",
          "type": "string"
        },
        "workflow_id": {
          "title": "Workflow Id",
          "type": "string"
        },
        "temporal_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temporal Run Id"
        },
        "status": {
          "enum": [
            "CREATED",
            "PREPARING",
            "RENDERING",
            "COMPLETED",
            "PAUSED",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "pause_requested": {
          "title": "Pause Requested",
          "type": "boolean"
        },
        "row_version": {
          "title": "Row Version",
          "type": "integer"
        },
        "control_seq": {
          "title": "Control Seq",
          "type": "integer"
        },
        "completed_shots": {
          "title": "Completed Shots",
          "type": "integer"
        },
        "total_shots": {
          "title": "Total Shots",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "production_run_id",
        "project_id",
        "snapshot_id",
        "workflow_id",
        "temporal_run_id",
        "status",
        "stage",
        "pause_requested",
        "row_version",
        "control_seq",
        "completed_shots",
        "total_shots",
        "error",
        "created_at",
        "updated_at"
      ],
      "title": "ProductionRun",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "product_profile_ref": {
          "const": "narrated-portrait/v1",
          "title": "Product Profile Ref",
          "type": "string"
        },
        "row_version": {
          "minimum": 1,
          "title": "Row Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "archived_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archived At"
        }
      },
      "required": [
        "project_id",
        "tenant_id",
        "title",
        "product_profile_ref",
        "row_version",
        "created_at",
        "updated_at",
        "archived_at"
      ],
      "title": "Project",
      "type": "object"
    },
    "ScriptContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "script",
          "default": "script",
          "title": "Kind",
          "type": "string"
        },
        "brief_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/ScriptSegment"
          },
          "maxItems": 100,
          "title": "Segments",
          "type": "array"
        }
      },
      "title": "ScriptContent",
      "type": "object"
    },
    "ScriptSegment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Segment Id",
          "type": "string"
        },
        "spoken_text": {
          "default": "",
          "maxLength": 20000,
          "title": "Spoken Text",
          "type": "string"
        },
        "visual_description": {
          "default": "",
          "maxLength": 20000,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "segment_id"
      ],
      "title": "ScriptSegment",
      "type": "object"
    },
    "StoryboardContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "storyboard",
          "default": "storyboard",
          "title": "Kind",
          "type": "string"
        },
        "script_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fps": {
          "const": 24,
          "default": 24,
          "title": "Fps",
          "type": "integer"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/StoryboardShot"
          },
          "maxItems": 8,
          "title": "Shots",
          "type": "array"
        }
      },
      "title": "StoryboardContent",
      "type": "object"
    },
    "StoryboardShot": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Shot Id",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Segment Ids",
          "type": "array"
        },
        "intent": {
          "default": "",
          "maxLength": 20000,
          "title": "Intent",
          "type": "string"
        },
        "camera": {
          "default": "",
          "maxLength": 20000,
          "title": "Camera",
          "type": "string"
        },
        "duration_frames": {
          "default": 240,
          "maximum": 1440,
          "minimum": 1,
          "title": "Duration Frames",
          "type": "integer"
        }
      },
      "required": [
        "shot_id"
      ],
      "title": "StoryboardShot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project": {
      "$ref": "#/$defs/Project"
    },
    "event_cursor": {
      "title": "Event Cursor",
      "type": "integer"
    },
    "contents": {
      "items": {
        "$ref": "#/$defs/ContentHead"
      },
      "title": "Contents",
      "type": "array"
    },
    "approvals": {
      "items": {
        "$ref": "#/$defs/Approval"
      },
      "title": "Approvals",
      "type": "array"
    },
    "production_runs": {
      "items": {
        "$ref": "#/$defs/ProductionRun"
      },
      "title": "Production Runs",
      "type": "array"
    }
  },
  "required": [
    "project",
    "event_cursor"
  ],
  "title": "ProjectSnapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
