{
  "$defs": {
    "Project": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "product_profile_ref": {
          "const": "narrated-portrait/v1",
          "title": "Product Profile Ref",
          "type": "string"
        },
        "row_version": {
          "minimum": 1,
          "title": "Row Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "archived_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archived At"
        }
      },
      "required": [
        "project_id",
        "tenant_id",
        "title",
        "product_profile_ref",
        "row_version",
        "created_at",
        "updated_at",
        "archived_at"
      ],
      "title": "Project",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "items",
    "total",
    "next_cursor"
  ],
  "title": "ProjectPage",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
