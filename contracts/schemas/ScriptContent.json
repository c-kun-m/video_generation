{
  "$defs": {
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "content",
          "default": "content",
          "title": "Kind",
          "type": "string"
        },
        "entity_kind": {
          "enum": [
            "brief",
            "script",
            "storyboard"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "revision_id",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ScriptSegment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Segment Id",
          "type": "string"
        },
        "spoken_text": {
          "default": "",
          "maxLength": 20000,
          "title": "Spoken Text",
          "type": "string"
        },
        "visual_description": {
          "default": "",
          "maxLength": 20000,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "segment_id"
      ],
      "title": "ScriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "script",
      "default": "script",
      "title": "Kind",
      "type": "string"
    },
    "brief_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/ScriptSegment"
      },
      "maxItems": 100,
      "title": "Segments",
      "type": "array"
    }
  },
  "title": "ScriptContent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
