{
  "$defs": {
    "ApprovalRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "approval",
          "default": "approval",
          "title": "Kind",
          "type": "string"
        },
        "approval_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Approval Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id"
      ],
      "title": "ApprovalRef",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "content",
          "default": "content",
          "title": "Kind",
          "type": "string"
        },
        "entity_kind": {
          "enum": [
            "brief",
            "script",
            "storyboard"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "revision_id",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "default": "",
          "title": "Trace Id",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldIssue"
          },
          "title": "Fields",
          "type": "array"
        },
        "current_row_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Row Version"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "FieldIssue": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ],
      "title": "FieldIssue",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "product_profile_ref": {
          "const": "narrated-portrait/v1",
          "title": "Product Profile Ref",
          "type": "string"
        },
        "row_version": {
          "minimum": 1,
          "title": "Row Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "archived_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archived At"
        }
      },
      "required": [
        "project_id",
        "tenant_id",
        "title",
        "product_profile_ref",
        "row_version",
        "created_at",
        "updated_at",
        "archived_at"
      ],
      "title": "Project",
      "type": "object"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "project",
          "default": "project",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectRef",
      "type": "object"
    },
    "RunRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "production_run",
          "default": "production_run",
          "title": "Kind",
          "type": "string"
        },
        "production_run_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Production Run Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "production_run_id",
        "snapshot_id"
      ],
      "title": "RunRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Command Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "APPLIED",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "business_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectRef"
        },
        {
          "$ref": "#/$defs/ContentRef"
        },
        {
          "$ref": "#/$defs/ApprovalRef"
        },
        {
          "$ref": "#/$defs/RunRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Business Result Ref"
    },
    "project": {
      "anyOf": [
        {
          "$ref": "#/$defs/Project"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "CommandResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
