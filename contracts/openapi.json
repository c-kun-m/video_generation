  "components": {
    "schemas": {
      "Capabilities": {
        "properties": {
          "app_version": {
            "type": "string",
            "title": "App Version"
          },
          "contract_version": {
            "type": "string",
            "const": "video/v1",
            "title": "Contract Version",
            "default": "video/v1"
          },
          "product_profile": {
            "$ref": "#/components/schemas/ProductProfile"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "app_version",
          "capabilities"
        ],
        "title": "Capabilities"
      },
      "Capability": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_integrated"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "title": "Capability"
      },
      "CommandResult": {
        "properties": {
          "command_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Command Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "APPLIED",
              "REJECTED"
            ],
            "title": "Status"
          },
          "business_result_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectRef"
              },
              {
                "type": "null"
