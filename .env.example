# Copy with scripts/dev.ps1 setup; it generates a local database password.
VIDEO_DB_PASSWORD=replace-with-a-local-password
VIDEO_DATABASE_URL=postgresql+psycopg://video:replace-with-a-local-password@127.0.0.1:5432/video_generation
VIDEO_TEST_DATABASE_URL=postgresql+psycopg://video:replace-with-a-local-password@127.0.0.1:5432/video_generation_test
VIDEO_API_HOST=127.0.0.1
VIDEO_API_PORT=8000
VIDEO_SERVICE_URL=http://127.0.0.1:8000
