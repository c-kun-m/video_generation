{
  "name": "video-generation-desktop",
  "version": "0.2.0",
  "private": true,
  "main": "out/main/index.js",
  "description": "Video Generation desktop workbench",
  "author": "video-generation",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "contracts": "openapi-typescript ../contracts/openapi.json --default-non-nullable false -o src/shared/api.generated.ts && prettier --write src/shared/api.generated.ts",
    "format:check": "prettier --check src tests *.ts package.json tsconfig.json pnpm-workspace.yaml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "pnpm build && electron-builder --dir --win"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "ajv": "^8.17.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "build": {
    "appId": "com.video-generation.desktop",
    "productName": "Video Generation",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
